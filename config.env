# PPTist 服务配置（修改后重新运行 start-pptist.sh 生效）
PPTIST_PORT=8686
# 对外访问地址：其他电脑通过该地址访问上传页（已自动填入本机局域网 IP）
PPTIST_PUBLIC_URL=http://192.168.2.13:8686
PPTIST_DATA_DIR=/home/ztl/ppt/pptist-rk3588-lcd-deploy/data
# 副屏文稿（PPTist B）独立存储目录：与主屏完全独立的两份 PPT
PPTIST_SECONDARY_DATA_DIR=/home/ztl/ppt/pptist-rk3588-lcd-deploy/data/secondary-ppt
# LCD JPEG 缓存与岗位照片（升级时请保留 data/）
PPTIST_LED_CACHE_DIR=/home/ztl/ppt/pptist-rk3588-lcd-deploy/data/led-cache
PPTIST_LED_PORTRAIT_DIR=/home/ztl/ppt/pptist-rk3588-lcd-deploy/data/led-assets/portraits
# 上传大小上限（MB），默认 1024（1GB）；需要调整时取消注释并修改
# PPTIST_MAX_UPLOAD_MB=1024
